global:
  scrape_interval: 15s
  evaluation_interval: 15s

# Fichier de regles d'alerte (etat serveur, conteneurs, failles, redondances, CPU)
rule_files:
  - /etc/prometheus/alert-rules.yml

# Envoi des alertes vers Alertmanager
alerting:
  alertmanagers:
    - static_configs:
        - targets: ['localhost:9093']

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'node_exporter'
    static_configs:
      - targets: ['localhost:9100']

  # Metriques Docker : etat des conteneurs, restart, CPU, memoire
  - job_name: 'cadvisor'
    static_configs:
      - targets: ['localhost:9101']